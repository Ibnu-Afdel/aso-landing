---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  noindex = false,
  title = 'Aso — the batteries-included Python web framework',
  description = 'Aso is a batteries-included Python web framework: FastAPI on the server, React on the client, Inertia in between. Routing, an async ORM, auth, queues, mail and an artisan-style CLI, ready on day one.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: 'Aso',
  description,
  url: Astro.site?.toString(),
  codeRepository: 'https://github.com/Ibnu-Afdel/Aso',
  programmingLanguage: ['Python', 'TypeScript'],
  license: 'https://opensource.org/licenses/MIT',
  runtimePlatform: 'Python 3.12+',
  author: { '@type': 'Person', name: 'Abubeker Afdel', url: 'https://github.com/Ibnu-Afdel' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f6f1e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121917" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Aso" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Aso crystal mark and wordmark on a cream background" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />

    <script is:inline>document.documentElement.classList.add('js');</script>
    <script is:inline>
      // QA only: ?qa-theme=dark|light forces a palette for screenshot tooling that can't
      // emulate prefers-color-scheme from the command line. Sets the custom properties
      // directly (not a CSS attribute selector) so it wins regardless of cascade layers.
      // No effect without the param.
      var qaTheme = new URLSearchParams(location.search).get('qa-theme');
      var qaPalettes = {
        dark: { '--bg': '#121917', '--fg': '#ece6da', '--muted': 'color-mix(in oklab, #ece6da 64%, transparent)', '--faint': 'color-mix(in oklab, #ece6da 11%, transparent)', '--raised': '#19221f', '--accent': '#8fae93', colorScheme: 'dark' },
        light: { '--bg': '#f6f1e8', '--fg': '#213231', '--muted': 'color-mix(in oklab, #213231 68%, transparent)', '--faint': 'color-mix(in oklab, #213231 13%, transparent)', '--raised': '#fbf8f2', '--accent': '#6d8b71', colorScheme: 'light' },
      };
      if (qaPalettes[qaTheme]) {
        var root = document.documentElement.style;
        var palette = qaPalettes[qaTheme];
        for (var key in palette) {
          if (key === 'colorScheme') root.colorScheme = palette[key];
          else root.setProperty(key, palette[key]);
        }
      }
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="grain min-h-screen">
    <slot />
  </body>
</html>
