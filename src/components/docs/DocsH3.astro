---
interface Props {
  id?: string;
}
const { id } = Astro.props;
---

<h3 id={id} class="group mt-8 scroll-mt-24 text-lg font-medium tracking-[-0.01em]">
  <a href={id ? `#${id}` : undefined} class="no-underline">
    <slot />
    {id && <span class="ml-2 text-[var(--accent)] opacity-0 transition group-hover:opacity-100" aria-hidden="true">#</span>}
  </a>
</h3>
