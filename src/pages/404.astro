---
import Layout from '../layouts/Layout.astro';
import Mark from '../components/Mark.astro';
---
<Layout noindex title="Page not found · Aso" description="This page doesn't exist. Head back to the Aso homepage.">
  <main class="flex min-h-screen flex-col items-center justify-center px-6 text-center">
    <Mark animated class="size-24 text-[var(--fg)]" />
    <p class="mt-8 font-mono text-xs tracking-wider text-[var(--accent)] uppercase">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-[-0.03em]">Nothing here.</h1>
    <p class="mt-3 text-[var(--muted)]">The page you're looking for doesn't exist.</p>
    <a href="/" class="mt-8 rounded-full bg-[var(--fg)] px-5 py-2.5 text-sm font-medium text-[var(--bg)] transition hover:opacity-85">Back home</a>
  </main>
</Layout>
