---
import { Code } from 'astro:components';
import Layout from '../layouts/Layout.astro';
import Mark from '../components/Mark.astro';
import Wordmark from '../components/Wordmark.astro';

const github = 'https://github.com/Ibnu-Afdel/Aso';
const pypi = 'https://pypi.org/project/aso/';

const samples = [
  {
    id: 'routes',
    file: 'routes/web.py',
    lang: 'python',
    code: `from aso.routing import Route

from app.http.controllers.post_controller import PostController

with Route.middleware("auth").group():
    Route.get("/posts", [PostController, "index"]).name("posts.index")
    Route.post("/posts", [PostController, "store"]).name("posts.store")`,
  },
  {
    id: 'controller',
    file: 'app/http/controllers/post_controller.py',
    lang: 'python',
    code: `class PostController(Controller):
    async def index(self):
        posts = await Post.with_("author").latest().paginate(15)
        return inertia("posts/index", {"posts": posts})

    async def store(self, form: StorePostRequest):
        await Post.create(**form.validated(), user_id=auth().id())
        return redirect().route("posts.index").with_flash("success", "Post created.")`,
  },
  {
    id: 'request',
    file: 'app/http/requests/store_post_request.py',
    lang: 'python',
    code: `from pydantic import Field

from aso.http import FormRequest


class StorePostRequest(FormRequest):
    title: str = Field(min_length=3, max_length=255)
    body: str`,
  },
  {
    id: 'page',
    file: 'resources/js/pages/posts/index.tsx',
    lang: 'tsx',
    code: `import { Form } from '@inertiajs/react';
import { store } from '@/routes/posts';

export default function Index({ posts }: { posts: Paginated<Post> }) {
    return (
        <>
            {posts.data.map((post) => <PostCard key={post.id} post={post} />)}

            <Form {...store.form()}>
                <input name="title" />
                <textarea name="body" />
                <button>Publish</button>
            </Form>
        </>
    );
}`,
  },
];

const features = [
  {
    title: 'An artisan-style CLI',
    body: 'make:model, make:controller, make:request, migrate, queue:work, route:list. Generators write the boring parts so you start from working code.',
    tag: 'aso make:model Post -mcr',
  },
  {
    title: 'React pages, no API layer',
    body: 'Controllers return Inertia pages with their props. The browser gets a real React app; you never write fetch calls or JSON endpoints for your own UI.',
    tag: 'inertia("posts/index", {...})',
  },
  {
    title: 'An async ORM that reads well',
    body: 'Models, relationships, scopes, eager loading and pagination on SQLAlchemy 2. Lazy loads raise instead of silently hitting the database.',
    tag: 'await Post.with_("author").paginate(15)',
  },
  {
    title: 'Auth from the first run',
    body: 'Registration, login, password reset, email verification and profile settings, already wired to pages in the React starter kit.',
    tag: 'Route.middleware("auth")',
  },
  {
    title: 'Typed routes in TypeScript',
    body: 'Your Python routes become typed TypeScript helpers. Rename a route and the compiler tells you every link that broke.',
    tag: 'aso routes:generate',
  },
  {
    title: 'Queues, mail, cache, storage',
    body: 'Jobs, a worker, mailables, cache and file storage with the same small, consistent API. Local mail lands in a log so nothing leaks while you build.',
    tag: 'aso queue:work',
  },
];

const steps = [
  { title: 'Create an app', cmd: 'uvx aso new myapp', note: 'Python deps, npm packages and the first migration, in one go.' },
  { title: 'Start everything', cmd: 'cd myapp && uv run aso dev', note: 'Server, Vite and the route watcher (plus a queue worker if you use one). Port taken? It picks the next free one.' },
  { title: 'Build your thing', cmd: 'uv run aso make:model Post -mcr', note: 'Model, migration, controller and form requests. Then open resources/js/pages.' },
];
---

<Layout>
  <!-- Navigation -->
  <header class="sticky top-0 z-40 border-b border-transparent transition-colors [&.scrolled]:border-[var(--faint)] [&.scrolled]:backdrop-blur-md" data-nav>
    <div class="absolute inset-0 -z-10 bg-[var(--bg)]/80 opacity-0 transition-opacity duration-300 [.scrolled_&]:opacity-100"></div>
    <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8" aria-label="Main">
      <a href="/" class="flex items-center gap-2.5" aria-label="Aso home">
        <Mark class="size-7 text-[var(--fg)]" />
        <Wordmark class="h-[18px] w-auto text-[var(--fg)]" />
      </a>
      <div class="flex items-center gap-1 text-sm">
        <a href="#code" class="hidden rounded-full px-3.5 py-1.5 text-[var(--muted)] transition hover:text-[var(--fg)] sm:block">Code</a>
        <a href="#features" class="hidden rounded-full px-3.5 py-1.5 text-[var(--muted)] transition hover:text-[var(--fg)] sm:block">Features</a>
        <a href="#start" class="hidden rounded-full px-3.5 py-1.5 text-[var(--muted)] transition hover:text-[var(--fg)] sm:block">Get started</a>
        <a href="/docs" class="rounded-full px-3 py-1.5 font-medium text-[var(--fg)] transition hover:opacity-80 sm:px-3.5 sm:font-normal sm:text-[var(--muted)] sm:hover:text-[var(--fg)]">Docs</a>
        <a href={github} class="ml-2 inline-flex items-center gap-2 rounded-full bg-[var(--fg)] px-4 py-1.5 font-medium text-[var(--bg)] transition hover:opacity-85">
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.39-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
          GitHub
        </a>
        <button type="button" data-home-menu aria-expanded="false" aria-controls="home-menu" aria-label="Open menu" class="ml-1 inline-flex size-9 items-center justify-center rounded-full border border-[var(--faint)] text-[var(--fg)] sm:hidden">
          <svg class="size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M3.5 6.5h13M3.5 13.5h13" /></svg>
        </button>
      </div>
    </nav>
    <div id="home-menu" data-home-menu-panel hidden class="border-t border-[var(--faint)] bg-[var(--bg)] px-5 pb-5 sm:hidden">
      <a href="#code" class="block border-b border-[var(--faint)] py-3.5 text-[var(--fg)]">Code</a>
      <a href="#features" class="block border-b border-[var(--faint)] py-3.5 text-[var(--fg)]">Features</a>
      <a href="#start" class="block border-b border-[var(--faint)] py-3.5 text-[var(--fg)]">Get started</a>
      <a href="/docs" class="block border-b border-[var(--faint)] py-3.5 text-[var(--fg)]">Docs</a>
      <a href="https://pypi.org/project/aso/" class="block py-3.5 text-[var(--fg)]">PyPI</a>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section class="relative overflow-x-clip">
      <div aria-hidden="true" class="pointer-events-none absolute top-[-16rem] left-1/2 h-[36rem] w-[56rem] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,color-mix(in_oklab,var(--color-sage)_22%,transparent),transparent)]"></div>
      <div class="relative mx-auto grid max-w-6xl items-center gap-14 px-5 pt-16 pb-24 sm:px-8 lg:grid-cols-[1.2fr_1fr] lg:pt-24 lg:pb-32">
        <div>
          <p class="rise inline-flex items-center gap-2 rounded-full border border-[var(--faint)] px-3 py-1 font-mono text-xs text-[var(--muted)]" style="--delay:.05s">
            <span class="relative flex size-1.5"><span class="absolute inline-flex size-full animate-ping rounded-full bg-[var(--accent)] opacity-60"></span><span class="relative inline-flex size-1.5 rounded-full bg-[var(--accent)]"></span></span>
            v0.2 · early release · MIT
          </p>
          <h1 class="rise mt-6 text-[2.2rem] leading-[1.05] min-[400px]:text-[2.6rem] font-semibold tracking-[-0.035em] text-balance sm:text-6xl lg:text-[3.15rem]" style="--delay:.12s">
            The batteries&#8209;included <span class="text-[var(--accent)]">Python</span> web framework.
          </h1>
          <p class="rise mt-6 max-w-xl text-lg leading-relaxed text-pretty text-[var(--muted)]" style="--delay:.2s">
            FastAPI on the server, React on the client, Inertia in between. Routing, an async ORM, auth, queues and an artisan-style CLI, ready on day one.
          </p>

          <div class="rise mt-9 flex flex-wrap items-center gap-3" style="--delay:.28s">
            <button type="button" data-copy="uvx aso new myapp" class="group inline-flex items-center gap-3 rounded-xl border border-[var(--faint)] bg-[var(--raised)] py-3 pr-3 pl-4 font-mono text-sm shadow-[0_1px_0_var(--faint)] transition hover:border-[color-mix(in_oklab,var(--accent)_55%,transparent)]" aria-label="Copy install command">
              <span class="text-[var(--accent)]">$</span>
              <span>uvx aso new myapp</span>
              <span class="ml-1 rounded-md border border-[var(--faint)] px-2 py-0.5 font-sans text-xs text-[var(--muted)] transition group-hover:text-[var(--fg)]" data-copy-label>Copy</span>
            </button>
            <a href="#start" class="inline-flex items-center gap-1.5 rounded-xl px-1 py-3 text-sm font-medium text-[var(--muted)] sm:px-4 transition hover:text-[var(--fg)]">
              Quick start
              <svg class="size-4 transition group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.64l-3.22-3.22a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l3.22-3.22H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
            </a>
            <a href="/docs" class="inline-flex items-center gap-1.5 rounded-xl px-1 py-3 text-sm font-medium text-[var(--muted)] sm:px-4 transition hover:text-[var(--fg)]">
              Read the docs
            </a>
          </div>
          <p class="rise mt-4 text-xs text-[var(--muted)]" style="--delay:.34s">Needs <a class="underline decoration-[var(--faint)] underline-offset-4 hover:decoration-current" href="https://docs.astral.sh/uv/">uv</a>, Python 3.12+ and Node 22+.</p>
        </div>

        <!-- Crystal + live terminal -->
        <div class="relative mx-auto w-full max-w-md lg:max-w-none">
          <Mark animated class="absolute -top-6 right-2 hidden size-36 sm:block text-[var(--fg)] sm:size-44 lg:-top-14 lg:right-4" title="Aso crystal mark" />
          <div class="rise relative overflow-hidden sm:mt-28 rounded-2xl border border-white/5 bg-[#17211f] text-[#e3ddd0] shadow-[0_30px_80px_-30px_rgba(18,25,23,.55)]" style="--delay:.35s">
            <div class="flex items-center gap-2 border-b border-white/5 px-4 py-3">
              <span class="size-2.5 rounded-full bg-white/15"></span>
              <span class="size-2.5 rounded-full bg-white/15"></span>
              <span class="size-2.5 rounded-full bg-white/15"></span>
              <span class="ml-3 font-mono text-xs text-white/40">~/code</span>
            </div>
            <pre class="h-[22.5rem] overflow-hidden px-4 py-4 font-mono text-[0.72rem] leading-5 whitespace-pre-wrap sm:h-[19.5rem] sm:px-5 sm:text-[0.8rem] sm:leading-6" aria-label="Terminal demo: creating and running an Aso app" data-terminal><span class="text-[#8fae93]">$</span> uvx aso new myapp
Creating a new Aso application in ./myapp...
<span class="text-[#8fae93]">$</span> cd myapp && uv run aso dev
  App   http://127.0.0.1:8000  &lt;- open</pre>
          </div>
        </div>
      </div>
    </section>

    <!-- Code -->
    <section id="code" class="scroll-mt-20 border-t border-[var(--faint)] py-24 sm:py-32">
      <div class="mx-auto max-w-6xl px-5 sm:px-8">
        <div class="max-w-2xl" data-reveal>
          <p class="font-mono text-xs tracking-wider text-[var(--accent)] uppercase">How it reads</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-[-0.03em] text-balance sm:text-4xl">One feature, top to bottom, in four small files.</h2>
          <p class="mt-4 text-[var(--muted)]">A route, a controller, a validated request and a React page. No serializers, no API client, no glue.</p>
        </div>

        <div class="mt-12 grid gap-6 lg:grid-cols-[16rem_1fr]" data-reveal style="--delay:.1s">
          <div class="grid grid-cols-2 gap-2 sm:flex sm:overflow-x-auto lg:flex-col" role="tablist" aria-label="Example files">
            {samples.map((s, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${s.id}`}
                aria-controls={`panel-${s.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                data-tab={s.id}
                class="min-w-0 shrink-0 truncate rounded-xl border border-transparent px-4 py-3 text-left font-mono text-xs text-[var(--muted)] transition hover:text-[var(--fg)] aria-selected:border-[var(--faint)] aria-selected:bg-[var(--raised)] aria-selected:text-[var(--fg)]"
              >
                <span class="mr-2 text-[var(--accent)]">0{i + 1}</span>{s.file.split('/').pop()}
                <span class="mt-1 hidden truncate text-[0.68rem] opacity-60 lg:block">{s.file}</span>
              </button>
            ))}
          </div>
          <div class="code-panel overflow-hidden lg:min-h-[25rem] rounded-2xl border border-white/5 bg-[#17211f] shadow-[0_30px_80px_-40px_rgba(18,25,23,.5)]">
            {samples.map((s, i) => (
              <div id={`panel-${s.id}`} role="tabpanel" aria-labelledby={`tab-${s.id}`} hidden={i !== 0} data-panel={s.id}>
                <div class="border-b border-white/5 px-6 py-3 font-mono text-xs text-white/45">{s.file}</div>
                <Code code={s.code} lang={s.lang as any} theme="everforest-dark" />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="scroll-mt-20 border-t border-[var(--faint)] py-24 sm:py-32">
      <div class="mx-auto max-w-6xl px-5 sm:px-8">
        <div class="max-w-2xl" data-reveal>
          <p class="font-mono text-xs tracking-wider text-[var(--accent)] uppercase">What's included</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-[-0.03em] text-balance sm:text-4xl">Everything a real app needs, already in the box.</h2>
          <p class="mt-4 text-[var(--muted)]">If you know Laravel, you already know where things go. If you know Python, you already know how they work.</p>
        </div>
        <div class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-[var(--faint)] bg-[var(--faint)] sm:grid-cols-2 lg:grid-cols-3">
          {features.map((f, i) => (
            <article class="group bg-[var(--bg)] p-7 transition-colors hover:bg-[var(--raised)]" data-reveal style={`--delay:${(i % 3) * 0.08}s`}>
              <span class="font-mono text-xs text-[var(--accent)]">0{i + 1}</span>
              <h3 class="mt-3 text-lg font-medium tracking-tight">{f.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--muted)]">{f.body}</p>
              <code class="mt-5 block truncate font-mono text-xs text-[var(--muted)] opacity-80 transition group-hover:text-[var(--accent)] group-hover:opacity-100">{f.tag}</code>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Agents -->
    <section class="border-t border-[var(--faint)] py-24 sm:py-32">
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 sm:px-8 lg:grid-cols-2">
        <div data-reveal>
          <p class="font-mono text-xs tracking-wider text-[var(--accent)] uppercase">Built for people and agents</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-[-0.03em] text-balance sm:text-4xl">Conventions your coding agent can't quietly break.</h2>
          <p class="mt-4 leading-relaxed text-[var(--muted)]">
            Every app ships with an <code class="font-mono text-[0.9em] text-[var(--fg)]">AGENTS.md</code> and architecture tests that run with your suite. Raw SQL with f-strings, queries in controllers, models that import HTTP code: they fail the build, whoever wrote them.
          </p>
        </div>
        <div class="rounded-2xl border border-[var(--faint)] bg-[var(--raised)] p-5 font-mono text-[0.7rem] leading-6 sm:p-6 sm:text-[0.8rem] sm:leading-7" data-reveal style="--delay:.1s">
          <p class="text-[var(--muted)]">$ uv run pytest tests/architecture</p>
          <p><span class="text-[var(--accent)]">✓</span> A1  controllers don't import sqlalchemy</p>
          <p><span class="text-[var(--accent)]">✓</span> A2  models work without a request</p>
          <p><span class="text-[var(--accent)]">✓</span> A3  input arrives through a FormRequest</p>
          <p><span class="text-[var(--accent)]">✓</span> A4  every Inertia page exists</p>
          <p><span class="text-[var(--accent)]">✓</span> A6  no interpolated SQL</p>
          <p class="text-[var(--muted)]">… 13 rules, all green</p>
        </div>
      </div>
    </section>

    <!-- Quick start -->
    <section id="start" class="scroll-mt-20 border-t border-[var(--faint)] py-24 sm:py-32">
      <div class="mx-auto max-w-6xl px-5 sm:px-8">
        <div class="max-w-2xl" data-reveal>
          <p class="font-mono text-xs tracking-wider text-[var(--accent)] uppercase">Get started</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-[-0.03em] text-balance sm:text-4xl">From nothing to a running app in about a minute.</h2>
        </div>
        <ol class="mt-14 grid gap-10 md:grid-cols-3 md:gap-8">
          {steps.map((s, i) => (
            <li class="border-t border-[var(--faint)] pt-6" data-reveal style={`--delay:${i * 0.1}s`}>
              <span class="font-mono text-xs text-[var(--accent)]">0{i + 1}</span>
              <h3 class="mt-2 text-lg font-medium tracking-tight">{s.title}</h3>
              <button type="button" data-copy={s.cmd} class="group mt-4 flex w-full items-center justify-between gap-3 rounded-xl border border-[var(--faint)] bg-[var(--raised)] px-4 py-3 text-left font-mono text-[0.8rem] transition hover:border-[color-mix(in_oklab,var(--accent)_55%,transparent)]" aria-label={`Copy: ${s.cmd}`}>
                <span class="truncate"><span class="text-[var(--accent)]">$</span> {s.cmd}</span>
                <span class="shrink-0 font-sans text-xs text-[var(--muted)] group-hover:text-[var(--fg)]" data-copy-label>Copy</span>
              </button>
              <p class="mt-3 text-sm leading-relaxed text-[var(--muted)]">{s.note}</p>
            </li>
          ))}
        </ol>
        <p class="mt-10 text-sm text-[var(--muted)]" data-reveal>
          Want the full walkthrough? Read the <a href="/docs" class="font-medium text-[var(--fg)] underline decoration-[var(--faint)] underline-offset-4 hover:decoration-current">docs</a>, including a tutorial that builds a small app end to end.
        </p>
      </div>
    </section>

    <!-- Closing -->
    <section class="border-t border-[var(--faint)]">
      <div class="mx-auto flex max-w-6xl flex-col items-center px-5 py-28 text-center sm:px-8" data-reveal>
        <Mark class="size-14 text-[var(--fg)]" />
        <h2 class="mt-8 text-3xl font-semibold tracking-[-0.03em] text-balance sm:text-4xl">Make something good.</h2>
        <p class="mt-4 max-w-md text-[var(--muted)]">Aso is young and moving fast. Try it, break it, and tell us what you'd want next.</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={github} class="rounded-full bg-[var(--fg)] px-5 py-2.5 text-sm font-medium text-[var(--bg)] transition hover:opacity-85">Star on GitHub</a>
          <a href={pypi} class="rounded-full border border-[var(--faint)] px-5 py-2.5 text-sm font-medium transition hover:bg-[var(--raised)]">View on PyPI</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-[var(--faint)]">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-5 py-8 text-sm text-[var(--muted)] sm:flex-row sm:px-8">
      <div class="flex items-center gap-2.5">
        <Mark class="size-5 text-[var(--fg)]" />
        <Wordmark class="h-3.5 w-auto text-[var(--fg)]" />
        <span class="ml-2">MIT licensed</span>
      </div>
      <div class="flex gap-5">
        <a class="transition hover:text-[var(--fg)]" href="/docs">Docs</a>
        <a class="transition hover:text-[var(--fg)]" href={github}>GitHub</a>
        <a class="transition hover:text-[var(--fg)]" href={pypi}>PyPI</a>
        <a class="transition hover:text-[var(--fg)]" href={`${github}/issues`}>Issues</a>
      </div>
    </div>
  </footer>
</Layout>

<script>
  // Sticky nav border once the page scrolls.
  const nav = document.querySelector('[data-nav]');
  const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Phone menu.
  const menuButton = document.querySelector<HTMLButtonElement>('[data-home-menu]');
  const menuPanel = document.querySelector<HTMLElement>('[data-home-menu-panel]');
  const setMenu = (open: boolean) => {
    if (!menuButton || !menuPanel) return;
    menuPanel.hidden = !open;
    menuButton.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('menu-open', open);
  };
  menuButton?.addEventListener('click', () => setMenu(menuPanel?.hidden ?? false));
  menuPanel?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

  // Reveal sections as they enter the viewport.
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      }
    },
    { rootMargin: '0px 0px -10% 0px' },
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

  // Copy buttons.
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const label = button.querySelector('[data-copy-label]');
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        if (label) label.textContent = 'Copied';
      } catch {
        if (label) label.textContent = 'Select & copy';
      }
      setTimeout(() => label && (label.textContent = 'Copy'), 1600);
    });
  });

  // Code tabs.
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-tab]');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      document.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel) => {
        panel.hidden = panel.dataset.panel !== tab.dataset.tab;
      });
    });
  });

  // The hero terminal types a short session on a loop.
  const terminal = document.querySelector<HTMLElement>('[data-terminal]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  type Line = { cmd?: string; out?: string; cls?: string; pause?: number };
  const session: Line[] = [
    { cmd: 'uvx aso new myapp' },
    { out: 'Creating a new Aso application in ./myapp...', cls: 'text-white/55' },
    { out: 'Installing Python dependencies (uv sync)...', cls: 'text-white/55' },
    { out: 'Installing npm packages...', cls: 'text-white/55' },
    { out: 'Migration table migrated successfully.', cls: 'text-white/55' },
    { out: 'Aso application ready.', cls: 'text-[#8fae93]', pause: 700 },
    { cmd: 'cd myapp && uv run aso dev' },
    { out: '  App   http://127.0.0.1:8000  <- open', cls: 'text-[#e3ddd0]' },
    { out: '  Vite  http://localhost:5173  (hot reload)', cls: 'text-white/55' },
    { out: 'server | Application startup complete.', cls: 'text-white/40' },
    { out: 'routes | Wrote 22 file(s).', cls: 'text-white/40', pause: 3200 },
  ];
  const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  async function play() {
    if (!terminal) return;
    for (;;) {
      let html = '';
      for (const line of session) {
        if (line.cmd) {
          const prompt = '<span class="text-[#8fae93]">$</span> ';
          for (let i = 0; i <= line.cmd.length; i++) {
            terminal.innerHTML = html + prompt + escape(line.cmd.slice(0, i)) + '<span class="caret"></span>';
            await sleep(38 + Math.random() * 45);
          }
          html += prompt + escape(line.cmd) + '\n';
          await sleep(350);
        } else if (line.out) {
          html += `<span class="${line.cls ?? ''}">${escape(line.out)}</span>\n`;
          terminal.innerHTML = html + '<span class="caret"></span>';
          await sleep(line.pause ?? 260);
        }
      }
      await sleep(1200);
    }
  }
  if (terminal && !reduceMotion) {
    const start = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        start.disconnect();
        play();
      }
    });
    start.observe(terminal);
  }
</script>
